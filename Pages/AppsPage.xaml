<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GPUAssign.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GPUAssign.Pages"
    xmlns:models="using:GPUAssign.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,4">
            <TextBlock
                x:Name="PageTitleText"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="アプリ管理"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock
                x:Name="PageSubtitleText"
                Margin="0,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="EXEのバージョンに依存しないGPU割り当てルールを管理します (クリックで編集)" />
        </StackPanel>

        <!-- Status bar / info strip with progress bar -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
            <InfoBar
                x:Name="StatusBar"
                IsClosable="True"
                IsOpen="False" />
            <ProgressBar
                x:Name="SyncProgressBar"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- App list -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <!-- Empty state -->
            <StackPanel
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE74C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    x:Name="EmptyStateText"
                    Text="登録されているアプリがありません。「アプリ追加」または「Windows設定からインポート」から登録してください。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <ListView
                x:Name="AppListView"
                ItemsSource="{x:Bind AppItems, Mode=OneWay}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="AppListView_ItemClick"
                SelectionChanged="AppListView_SelectionChanged">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppDefinition">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <!-- App icon (Actual EXE icon with letter fallback) -->
                            <Grid Grid.Column="0" Width="40" Height="40">
                                <Border
                                    Width="40" Height="40"
                                    CornerRadius="8"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="White"
                                        Text="{x:Bind NameInitial, Mode=OneWay}" />
                                </Border>
                                <Image
                                    Width="36" Height="36"
                                    Source="{x:Bind IconSource, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform" />
                            </Grid>

                            <!-- Name + path -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        FontSize="14"
                                        Text="{x:Bind Name, Mode=OneWay}" />
                                    <!-- Search mode badge -->
                                    <Border
                                        CornerRadius="4"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind SearchModeLabel, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind CurrentExePath, Mode=OneWay, TargetNullValue='─ 未検出'}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Category -->
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Category, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <!-- GPU selection dropdown directly in list row -->
                            <ComboBox
                                Grid.Column="3"
                                Width="140"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind GpuIndex, Mode=TwoWay}"
                                SelectionChanged="RowGpuComboBox_SelectionChanged"
                                Tag="{x:Bind}">
                                <ComboBoxItem Content="システム既定" />
                                <ComboBoxItem Content="省電力" />
                                <ComboBoxItem Content="高パフォーマンス" />
                            </ComboBox>

                            <!-- Sync status -->
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind SyncStatusLabel, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Bottom action bar -->
        <CommandBar
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Name="SyncButton"
                Icon="Sync"
                Label="今すぐ同期"
                Click="SyncButton_Click" />
            <AppBarButton
                x:Name="AddButton"
                Icon="Add"
                Label="アプリ追加"
                Click="AddButton_Click" />
            <AppBarButton
                x:Name="ImportExistingButton"
                Icon="Import"
                Label="Windows設定からインポート"
                Click="ImportExistingButton_Click" />
            <AppBarSeparator />
            <AppBarButton
                x:Name="OpenFolderButton"
                Icon="Folder"
                Label="フォルダを開く"
                IsEnabled="False"
                Click="OpenFolderButton_Click" />
            <AppBarButton
                x:Name="EditButton"
                Icon="Edit"
                Label="編集"
                IsEnabled="False"
                Click="EditButton_Click" />
            <AppBarButton
                x:Name="DeleteButton"
                Icon="Delete"
                Label="削除"
                IsEnabled="False"
                Click="DeleteButton_Click" />
        </CommandBar>
    </Grid>
</Page>
