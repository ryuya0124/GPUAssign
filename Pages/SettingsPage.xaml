<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GPUAssign.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:GPUAssign.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,20,24,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Spacing="20">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="PageTitleText"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="環境設定"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Name="PageSubtitleText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="並列スレッド数、外観テーマ、言語、自動同期の設定を行います" />
            </StackPanel>

            <!-- Status InfoBar -->
            <InfoBar
                x:Name="SettingsStatusInfoBar"
                IsClosable="True"
                IsOpen="False" />

            <!-- 1. Multithreading -->
            <StackPanel
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="8">
                <TextBlock
                    x:Name="ThreadsLabel"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Text="並列スレッド数 (マルチコア探索・同期)" />
                <TextBlock
                    x:Name="ThreadsDesc"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="EXE探索とGPU同期をバックグラウンドで並列処理するスレッド数を設定します" />
                <ComboBox
                    x:Name="ThreadsComboBox"
                    Margin="0,4,0,0"
                    Width="280"
                    SelectionChanged="ThreadsComboBox_SelectionChanged">
                    <ComboBoxItem Content="1 (シングルスレッド)" Tag="1" />
                    <ComboBoxItem Content="2 スレッド" Tag="2" />
                    <ComboBoxItem Content="4 スレッド (推奨・デフォルト)" Tag="4" />
                    <ComboBoxItem Content="8 スレッド (高速)" Tag="8" />
                    <ComboBoxItem Content="16 スレッド (最大)" Tag="16" />
                </ComboBox>
            </StackPanel>

            <!-- 2. Appearance -->
            <StackPanel
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="8">
                <TextBlock
                    x:Name="ThemeLabel"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Text="外観テーマ" />
                <ComboBox
                    x:Name="ThemeComboBox"
                    Width="240"
                    SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem x:Name="ThemeSystemItem" Content="システム設定に従う" Tag="System" />
                    <ComboBoxItem x:Name="ThemeLightItem" Content="ライト" Tag="Light" />
                    <ComboBoxItem x:Name="ThemeDarkItem" Content="ダーク" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <!-- 3. Language -->
            <StackPanel
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="8">
                <TextBlock
                    x:Name="LanguageLabel"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Text="表示言語" />
                <ComboBox
                    x:Name="LanguageComboBox"
                    Width="240"
                    SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem x:Name="LangAutoItem" Content="システム言語を自動検知" Tag="auto" />
                    <ComboBoxItem Content="日本語 (ja-JP)" Tag="ja-JP" />
                    <ComboBoxItem Content="English (en-US)" Tag="en-US" />
                </ComboBox>
            </StackPanel>

            <!-- 4. Automation -->
            <StackPanel
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="14">
                <ToggleSwitch
                    x:Name="AutoStartToggle"
                    Header="Windows ログオン時に自動同期"
                    Toggled="AutoStartToggle_Toggled" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,-6,0,0"
                    Text="ログオン30秒後にバックグラウンドで最新EXEを自動検出し、レジストリを同期します (常駐なし)" />

                <MenuFlyoutSeparator />

                <ToggleSwitch
                    x:Name="AutoCleanupToggle"
                    Header="更新時に古いバージョンの割り当てを自動削除"
                    Toggled="AutoCleanupToggle_Toggled" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="0,-6,0,0"
                    Text="新しいバージョンが見つかった際、レジストリに残っている古いEXEの登録を自動で削除します" />

                <Button
                    x:Name="CleanupNowButton"
                    Content="今すぐ古い設定を整理する"
                    Margin="0,4,0,0"
                    Click="CleanupNowButton_Click" />
            </StackPanel>

            <!-- 5. Portable storage info -->
            <StackPanel
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Spacing="8">
                <TextBlock
                    FontWeight="SemiBold"
                    FontSize="14"
                    Text="ポータブルデータ保存場所" />
                <TextBlock
                    x:Name="StoragePathText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Button
                    Content="📁 保存先フォルダをエクスプローラーで開く"
                    Margin="0,4,0,0"
                    Click="OpenDataFolderButton_Click" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
